/*
 * Hailin HL7621S —— OpenWrt 23.05 / kernel 5.15
 * 硬件依据：厂家 18.06 出厂固件分区表 / 引脚定义
 * 分区：u-boot 0x30000 / env 0x10000 / factory 0x10000 / firmware 0x50000+0xfb0000
 */

#include "mt7621.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	compatible = "hailin,hl7621s", "mediatek,mt7621-soc";
	model = "Hailin HL7621S";

	aliases {
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-running = &led_power;
		led-upgrade = &led_power;
		label-mac-device = &gmac0;
	};

	chosen {
		bootargs = "console=ttyS0,115200";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x10000000>; /* 256 MiB */
	};

	leds {
		compatible = "gpio-leds";

		led_power: led-power {
			label = "green:power";
			gpios = <&gpio 14 GPIO_ACTIVE_HIGH>;
		};

		led_4g: led-4g {
			label = "green:4g";
			gpios = <&gpio 13 GPIO_ACTIVE_LOW>;
		};

		led_wifi: led-wifi {
			label = "green:wifi";
			gpios = <&gpio 16 GPIO_ACTIVE_LOW>;
		};
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&gpio 17 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <1>;
		spi-max-frequency = <10000000>;
		broken-flash-reset;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x000000 0x030000>;
				read-only;
			};

			partition@30000 {
				label = "u-boot-env";
				reg = <0x030000 0x010000>;
			};

			factory: partition@40000 {
				label = "factory";
				reg = <0x040000 0x010000>;
				read-only;

				compatible = "nvmem-cells";
				#address-cells = <1>;
				#size-cells = <1>;

				macaddr_factory_e000: macaddr@e000 {
					reg = <0xe000 0x6>;
				};
			};

			partition@50000 {
				label = "firmware";
				reg = <0x050000 0xfb0000>; /* 16064 KiB */
			};
		};
	};
};

&gmac0 {
	phy-mode = "rgmii-rxid";
	nvmem-cells = <&macaddr_factory_e000>;
	nvmem-cell-names = "mac-address";
};

&gmac1 {
	status = "disabled";
};

&switch0 {
	ports {
		port@0 {
			status = "okay";
			label = "wan";
		};

		port@1 {
			status = "okay";
			label = "lan1";
		};

		port@2 {
			status = "okay";
			label = "lan2";
		};

		port@3 {
			status = "okay";
			label = "lan3";
		};

		port@4 {
			status = "okay";
			label = "lan4";
		};
	};
};

/* mini-PCIe 无线：AR9382 双频 ath9k，校准数据在网卡 EEPROM */
&pcie {
	status = "okay";
};

&sdhci {
	status = "okay";
};

&xhci {
	status = "okay";
};

&state_default {
	gpio {
		groups = "jtag", "rgmii2", "wdt";
		function = "gpio";
	};
};

&ethernet {
	pinctrl-names = "default";
	pinctrl-0 = <&rgmii1_pins &mdio_pins>;
};
