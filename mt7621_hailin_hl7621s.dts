#include "mt7621.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	compatible = "hailin,hl7621s", "mediatek,mt7621-soc";
	model = "Hailin HL7621S";

	aliases {
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-running = &led_power;
		led-upgrade = &led_power;
		label-mac-device = &gmac0;
	};

    // ========== 核心修改：补全启动参数兜底 ==========
	chosen {
		bootargs = "console=ttyS0,115200 root=/dev/mtdblock3 rootfstype=squashfs init=/init";
	};
    // ==============================================

	leds {
		compatible = "gpio-leds";

		led_power: power {
			label = "green:power";
			gpios = <&gpio 14 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};

		4g {
			label = "green:4g";
			gpios = <&gpio 13 GPIO_ACTIVE_LOW>;
		};

		wifi {
			label = "green:wifi";
			gpios = <&gpio 16 GPIO_ACTIVE_LOW>;
		};
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&gpio 17 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <10000000>;
		broken-flash-reset;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x000000 0x030000>;
				read-only;
			};

			partition@30000 {
				label = "u-boot-env";
				reg = <0x030000 0x010000>;
			};

			factory: partition@40000 {
				label = "factory";
				reg = <0x040000 0x010000>;
				read-only;
			};

			partition@50000 {
				compatible = "denx,uimage";
				label = "firmware";
				reg = <0x050000 0xfb0000>;
			};
		};
	};
};

&gmac0 {
	nvmem-cells = <&macaddr_factory_e000>;
	nvmem-cell-names = "mac-address";
};

&gmac1 {
	status = "okay";
	label = "wan";
	phy-handle = <&phy4>;

	nvmem-cells = <&macaddr_factory_e006>;
	nvmem-cell-names = "mac-address";
};

&mdio {
	phy0: ethernet-phy@0 {
		reg = <0>;
		phy-mode = "rgmii-rxid";
	};
	phy1: ethernet-phy@1 {
		reg = <1>;
		phy-mode = "rgmii-rxid";
	};
	phy2: ethernet-phy@2 {
		reg = <2>;
		phy-mode = "rgmii-rxid";
	};
	phy3: ethernet-phy@3 {
		reg = <3>;
		phy-mode = "rgmii-rxid";
	};
	phy4: ethernet-phy@4 {
		reg = <4>;
		phy-mode = "rgmii-rxid";
	};
};

&switch0 {
	ports {
		port@0 {
			status = "okay";
			label = "lan1";
		};
		port@1 {
			status = "okay";
			label = "lan2";
		};
		port@2 {
			status = "okay";
			label = "lan3";
		};
		port@3 {
			status = "okay";
			label = "lan4";
		};
	};
};

&pcie {
	status = "okay";
};

&sdhci {
	status = "okay";
};

&xhci {
	status = "okay";
};

&factory {
	compatible = "nvmem-cells";
	#address-cells = <1>;
	#size-cells = <1>;

	macaddr_factory_e000: macaddr@e000 {
		reg = <0xe000 0x6>;
	};

	macaddr_factory_e006: macaddr@e006 {
		reg = <0xe006 0x6>;
	};
};
